{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Groups messages into conversations",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "from_user_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "to_user_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "from_name": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "from_avatar": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "to_name": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "content": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            {
              "data.from_user_id": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio",
        "file",
        "icebreaker"
      ],
      "default": "text",
      "description": "Type of message content",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "media_url": {
      "type": "string",
      "description": "URL of attached media file",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "media_thumbnail": {
      "type": "string",
      "description": "Thumbnail for video/image media",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "file_name": {
      "type": "string",
      "description": "Original filename for file attachments",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "icebreaker_prompt": {
      "type": "string",
      "description": "Icebreaker question/prompt used",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was read"
    },
    "edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was last edited",
      "rls": {
        "update": {
          "$or": [
            {
              "data.from_user_id": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "parent_message_id": {
      "type": "string",
      "description": "For threaded replies",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "deleted_for_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Per-user hide list for message visibility"
    },
    "delivered_for_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Users who have received this message on their device"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Message reactions"
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "user_condition": {
                    "role": "coordinator"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "data.from_user_id": "{{user.email}}"
                },
                {
                  "data.to_user_id": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.from_user_id": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "user_condition": {
                    "role": "coordinator"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "data.from_user_id": "{{user.email}}"
                },
                {
                  "data.to_user_id": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.from_user_id": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}