{
  "name": "IntelligenceStudy",
  "type": "object",
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "parent_id": {
      "type": "string",
      "maxLength": 100
    },
    "source_filter": {
      "type": "string",
      "maxLength": 25
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "evidence",
              "interpretation",
              "hypothesis",
              "unresolved"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1200
          },
          "citations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "required": [
          "kind",
          "text",
          "citations"
        ]
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "maxLength": 80
          },
          "matched": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 400
            }
          },
          "profile_number": {
            "type": "string",
            "maxLength": 20
          }
        },
        "required": [
          "kind",
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "objective",
    "summary",
    "findings",
    "next_steps",
    "sources"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}