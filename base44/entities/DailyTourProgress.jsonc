{
  "name": "DailyTourProgress",
  "type": "object",
  "properties": {
    "sections_completed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "site_skills_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "rls": {
        "create": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "site_skills_reward": {
      "type": "string",
      "enum": [
        "processing",
        "claimed"
      ],
      "rls": {
        "create": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    }
  },
  "required": [
    "sections_completed"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}