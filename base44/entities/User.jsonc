{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "coordinator",
        "user"
      ],
      "default": "user"
    },
    "canopy_preferences": {
      "type": "object",
      "description": "Personal Command Canopy layout and scratchpad"
    },
    "dock_preferences": {
      "type": "object",
      "description": "Personal Dock Deck folders, widgets, and preferences"
    },
    "side_panel_bookmarks": {
      "type": "object",
      "description": "Member's personal side-panel bookmark sections"
    }
  }
}