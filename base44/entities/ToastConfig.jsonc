{
  "name": "ToastConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "intensity": {
      "type": "string",
      "enum": [
        "real_time",
        "balanced",
        "essential",
        "quiet"
      ],
      "default": "balanced"
    },
    "position": {
      "type": "string",
      "enum": [
        "top-left",
        "top-center",
        "top-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "default": "top-right"
    },
    "max_visible": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "default": 1
    },
    "stagger_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "default": 4200
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000,
      "default": 30000
    },
    "priority_durations": {
      "type": "object"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "important_only": {
      "type": "boolean",
      "default": false
    },
    "demo_mode": {
      "type": "boolean",
      "default": false
    },
    "show_earnings": {
      "type": "boolean",
      "default": true
    },
    "welcome_enabled": {
      "type": "boolean",
      "default": true
    },
    "quiet_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440,
      "default": 30
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}