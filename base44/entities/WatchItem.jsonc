{
  "name": "WatchItem",
  "type": "object",
  "properties": {
    "item_type": {
      "type": "string",
      "maxLength": 60
    },
    "record_id": {
      "type": "string",
      "maxLength": 200
    },
    "display_name": {
      "type": "string",
      "maxLength": 200
    },
    "route": {
      "type": "string",
      "maxLength": 500
    },
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "watchlist_name": {
      "type": "string",
      "default": "General",
      "maxLength": 80
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notify_on_new": {
      "type": "boolean",
      "default": true
    },
    "notify_on_change": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_type",
    "record_id",
    "display_name",
    "watchlist_name",
    "active"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}