{
  "name": "GoldFlakeProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "round": {
      "type": "string"
    },
    "started_at": {
      "type": "number"
    },
    "day": {
      "type": "string"
    },
    "awards": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "processing",
        "awarded"
      ]
    }
  },
  "required": [
    "user_id",
    "round",
    "started_at",
    "day",
    "awards",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}