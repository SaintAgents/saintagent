{
  "name": "GuideBlueprint",
  "type": "object",
  "properties": {
    "identity": {
      "type": "string",
      "maxLength": 800
    },
    "growth": {
      "type": "string",
      "maxLength": 800
    },
    "creation": {
      "type": "string",
      "maxLength": 800
    },
    "connections": {
      "type": "string",
      "maxLength": 800
    },
    "contribution": {
      "type": "string",
      "maxLength": 800
    },
    "evolution": {
      "type": "string",
      "maxLength": 800
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}